<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_article.xml : image on the left, title + date + likes on the right -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/articleCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_white_rounded"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/articleThumbnail"
        android:layout_width="128dp"
        android:layout_height="96dp"
        android:scaleType="centerCrop"
        android:background="@drawable/map_round_border"
        android:clipToOutline="true"
        android:contentDescription="Article image" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/articleTitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Understanding endometriosis: symptoms, diagnosis and treatment"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#2B1F27" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/articleDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Posted 12 Oct 2026"
                android:textSize="12sp"
                android:textColor="#8A7C82" />

            <TextView
                android:id="@+id/articleLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♥ 42"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#C1577B" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>