<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_calendar_day.xml : one cell of the calendar grid -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayCell"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/dayNumber"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="18"
        android:textSize="14sp"
        android:textColor="#2B1F27" />

    <!-- Dot shown under days that have events -->
    <View
        android:id="@+id/eventDot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/event_dot"
        android:visibility="invisible" />

</LinearLayout>