<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/home_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

            <!-- Header / profile card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/header_gradient"
                android:padding="20dp"
                android:layout_marginTop="40dp">

                <!-- Avatar -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/avatar_circle_bg">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profileAvatar"
                        android:layout_width="98dp"
                        android:layout_height="98dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile_picture"
                        android:contentDescription="Profile photo"
                        android:background="@drawable/avatar_circle_bg"
                        app:shapeAppearanceOverlay="@style/CircleImageView"/>

                </FrameLayout>

                <!-- Profile information -->
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp">

                    <!-- Name -->
                    <TextView
                        android:id="@+id/profileNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="10dp"
                        android:text="Jess"
                        android:textStyle="bold|italic"
                        android:textSize="24sp"
                        android:textColor="@android:color/white" />

                    <!-- Email -->
                    <TextView
                        android:id="@+id/profileEmailText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/profileNameText"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="4dp"
                        android:text="jess@example.com"
                        android:textSize="16sp"
                        android:textColor="#F0DCE4" />

                </RelativeLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="8dp"
                android:text="ACCOUNT"
                android:textStyle="bold"
                android:textSize="16sp"
                android:letterSpacing="0.08"
                android:textColor="#9C3A5C"
                android:gravity="center"
                android:layout_gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:gravity="center">

                <!--Username-->
                <EditText
                    android:id="@+id/usernameInput"
                    android:layout_width="300dp"
                    android:layout_height="25pt"
                    android:layout_marginTop="10dp"

                    android:hint="Username"
                    android:inputType="text" />

                <!--Email-->
                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="300dp"
                    android:layout_height="25pt"
                    android:layout_marginTop="10dp"

                    android:hint="Email"
                    android:inputType="text" />

                <!-- Change Profile Picture -->
                <LinearLayout
                    android:id="@+id/modifyProfilePictureButton"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/fact_of_the_day_card"
                    android:padding="12dp"
                    android:layout_marginTop="60dp"
                    android:layout_marginBottom="8dp"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Change Profile Picture"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:layout_gravity="center"
                        android:gravity="center"/>

                </LinearLayout>

                <!-- Save Changes -->
                <LinearLayout
                    android:id="@+id/modifyProfilePictureButton"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/fact_of_the_day_card"
                    android:padding="12dp"
                    android:layout_marginTop="60dp"
                    android:layout_marginBottom="8dp"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Change Profile Picture"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:layout_gravity="center"
                        android:gravity="center"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Log Out -->
            <LinearLayout
                android:id="@+id/logoutButton"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/logout_button"
                android:padding="12dp"
                android:layout_marginTop="175dp"
                android:layout_marginBottom="8dp"
                android:elevation="2dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Log Out"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#111111"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation bar (same as home) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:background="@color/bottom_bar_bg"
            android:elevation="8dp"
            android:paddingBottom="8dp">

            <!-- Chat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/chatButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/chat"
                    android:background="@android:color/transparent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Chat"
                    android:textSize="12sp"
                    android:textColor="#000000" />

            </LinearLayout>

            <!-- Forum -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/forumButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/forum"
                    android:background="@android:color/transparent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Forum"
                    android:textSize="12sp"
                    android:textColor="#000000" />

            </LinearLayout>

            <!-- Home (spacer under the elevated circle) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal">

                <ImageButton
                    android:id="@+id/homeButtonSpacerRef"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:visibility="invisible"
                    android:src="@drawable/home" />

            </LinearLayout>

            <!-- Articles -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/articlesButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/articles"
                    android:background="@android:color/transparent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Articles"
                    android:textSize="12sp"
                    android:textColor="#000000" />

            </LinearLayout>

            <!-- Profile (active tab) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/profileButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/profile"
                    android:background="@android:color/transparent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Profile"
                    android:textSize="12sp"
                    android:textColor="#000000" />

            </LinearLayout>

        </LinearLayout>

        <!-- Elevated Home button, floating above the bar -->
        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="5dp"
            android:background="@drawable/nav_home_circle_bg"
            android:elevation="10dp"
            android:src="@drawable/home"
            android:scaleType="centerInside"
            android:padding="14dp"
            android:contentDescription="Home" />

    </FrameLayout>

</FrameLayout>