<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

            <!-- Back -->
            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="@drawable/pill_button_bg"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="‹  Back"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:clickable="true"
                android:focusable="true" />

            <!-- Hero image -->
            <ImageView
                android:id="@+id/articleImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop"
                android:background="@drawable/map_round_border"
                android:clipToOutline="true"
                android:contentDescription="Article image" />

            <!-- Title -->
            <TextView
                android:id="@+id/articleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Understanding endometriosis"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="#2B1F27" />

            <!-- Date + likes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/articleDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Posted 12 Oct 2026"
                    android:textSize="16sp"
                    android:textColor="#8A7C82" />

                <TextView
                    android:id="@+id/articleLikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♥ 42"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#C1577B" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@android:color/black" />

            <!-- Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="16dp"
                android:layout_marginTop="14dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/articleBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Article text goes here."
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="#2B1F27" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>